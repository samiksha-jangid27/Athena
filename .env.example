# Athena Central Examination Platform Environment Variables
# COPY THIS FILE TO .env FOR LOCAL USE — NEVER COMMIT SECRETS OR .env FILES

# ---------------- Server & Network ----------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ---------------- Database (PostgreSQL / Prisma Postgres) ----------------
# Provide your PostgreSQL connection string for Render or Prisma Postgres:
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@hostname:5432/athena?schema=public

# ---------------- Authentication & Security ----------------
# Secret key used for signing JWT access tokens (use a 32+ character random string in production)
ATHENA_JWT_SECRET=replace_with_strong_production_jwt_secret_key_minimum_32_characters

# Default / Initial Administrator Account Bootstrap
ATHENA_ADMIN_USERNAME=admin
ATHENA_ADMIN_PASSWORD=replace_with_secure_initial_admin_password

# Legacy Instructor Authorization Key (Optional)
ATHENA_INSTRUCTOR_KEY=replace_with_instructor_key

# ---------------- Examination Defaults ----------------
ATHENA_EXAM_TITLE="Electron Fundamentals"
ATHENA_EXAM_MINUTES=15

# ---------------- Frontend Release Configuration ----------------
# Production API URL baked into packaged Electron client (Render hosted URL)
# Example: https://athena-backend-xxxx.onrender.com
VITE_ATHENA_API_URL=https://athena-exam-backend.onrender.com

# ---------------- Remote Proctoring Object Storage (Optional) ----------------
# S3-compatible remote storage credentials for camera and screen capture snapshots
ATHENA_S3_BUCKET=
ATHENA_S3_REGION=
ATHENA_S3_ENDPOINT=
ATHENA_S3_ACCESS_KEY_ID=
ATHENA_S3_SECRET_ACCESS_KEY=
