{
  "name": "athena",
  "version": "1.0.0",
  "description": "A cross-platform desktop examination and proctoring platform featuring exam integrity monitoring, camera and screen capture, instructor controls, and practical assessment support.",
  "repository": "https://github.com/samiksha-jangid27/Athena",
  "private": true,
  "scripts": {
    "backend": "npm --prefix backend start",
    "dev": "npm --prefix frontend run dev",
    "electron": "npm --prefix frontend run electron",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "build:frontend": "npm --prefix frontend run build",
    "dist": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.athena.desktop",
    "productName": "Athena",
    "directories": {
      "app": "frontend",
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "extendInfo": {
        "NSCameraUsageDescription": "Athena uses your camera during exams to take periodic photos for exam integrity, as explained before the exam starts."
      }
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "app/**/*",
      "!app/**/*.test.js",
      "dist/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!**/*.pem",
      "!**/*.key"
    ]
  }
}
